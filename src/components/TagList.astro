---
import { tagUrl } from '../lib/content';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags" aria-label="Tags">
      {tags.map((t) => (
        <li>
          <a href={tagUrl(t)}>{t.replace(/-/g, ' ')}</a>
        </li>
      ))}
    </ul>
  )
}
