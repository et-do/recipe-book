{
  "name": "recipe-book",

  // Floating tags on purpose: every rebuild picks up the current stable
  // Ubuntu LTS base, Node LTS, GitHub CLI and Claude Code.
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  "remoteUser": "vscode",

  // Runs on the Windows host (cmd.exe) before the container starts: make sure
  // the host folders for the bind mounts below exist, or Docker refuses to
  // start. Never fails.
  "initializeCommand": "mkdir \"%USERPROFILE%\\.devcontainer-state\\recipe-book\\claude\" \"%USERPROFILE%\\.devcontainer-state\\recipe-book\\shell-history\" 2>nul & exit /b 0",

  "mounts": [
    // Claude Code state (conversations, auth, settings, memory) lives in a
    // plain Windows folder, NOT a Docker volume: a Docker Desktop update on
    // 2026-11-26 wiped every named volume and all chat history with it.
    // Host path: %USERPROFILE%\.devcontainer-state\recipe-book\claude
    // Do not move this back to a named volume.
    "source=${localEnv:USERPROFILE}/.devcontainer-state/recipe-book/claude,target=/home/vscode/.claude,type=bind",
    // Shell history, same reason.
    "source=${localEnv:USERPROFILE}/.devcontainer-state/recipe-book/shell-history,target=/commandhistory,type=bind",
    // Keep node_modules off the Windows bind mount (much faster installs,
    // no symlink problems). Shows up as an empty folder on the host.
    // A volume is fine here: losing it only costs an `npm install`.
    "source=recipe-book-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],

  "containerEnv": {
    // Puts .claude.json (login + per-project state) inside the volume too;
    // by default it lives in ~ and would be lost on rebuild.
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "HISTFILE": "/commandhistory/.bash_history",
    "PROMPT_COMMAND": "history -a"
  },

  // Fresh mounts can be owned by root; hand them to the dev user.
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.claude /commandhistory ${containerWorkspaceFolder}/node_modules && if [ -f package.json ]; then npm install && npx playwright install --with-deps chromium; fi",

  // 4321 = Astro dev server, 4322 = Astro preview.
  "forwardPorts": [4321, 4322],
  "portsAttributes": {
    "4321": { "label": "Site (dev)", "onAutoForward": "notify" },
    "4322": { "label": "Site (preview)", "onAutoForward": "silent" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "astro-build.astro-vscode",
        "redhat.vscode-yaml",
        "editorconfig.editorconfig",
        "github.vscode-github-actions"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.formatOnSave": true
      }
    }
  }
}
