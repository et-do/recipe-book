{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "recipe-book",
      "include-component-in-tag": false,
      "bump-minor-pre-major": true,
      "changelog-sections": [
        { "type": "recipe", "section": "New recipes" },
        { "type": "tweak", "section": "Recipe changes" },
        { "type": "wiki", "section": "Ingredients and techniques" },
        { "type": "feat", "section": "Site and book" },
        { "type": "fix", "section": "Fixes" },
        { "type": "docs", "section": "Docs", "hidden": true },
        { "type": "chore", "section": "Chores", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "refactor", "section": "Refactors", "hidden": true },
        { "type": "style", "section": "Style", "hidden": true },
        { "type": "perf", "section": "Performance", "hidden": true }
      ]
    }
  }
}
